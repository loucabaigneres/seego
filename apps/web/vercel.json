{
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://voyagr-api-stg.onrender.com/api/auth/:path*"
    },
    { "source": "/trpc/:path*", "destination": "https://voyagr-api-stg.onrender.com/trpc/:path*" },
    { "source": "/image-proxy", "destination": "https://voyagr-api-stg.onrender.com/image-proxy" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
