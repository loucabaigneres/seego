{
  "expo": {
    "name": "Seego",
    "slug": "seego",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "seego",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.seego.app"
    },
    "android": {
      "package": "com.seego.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F0E8"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F0E8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
