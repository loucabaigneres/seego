# Base URL of the Seego API. The waitlist form submits through tRPC at
# `${VITE_API_URL}/trpc`. Defaults to http://localhost:3000 when unset.
VITE_API_URL=http://localhost:3000

# PostHog (EU cloud). Tracking only runs in production builds and only when a key is set,
# and only after the visitor accepts the consent banner. The `phc_…` project key is public.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
