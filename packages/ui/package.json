{
  "name": "@seego/ui",
  "version": "1.0.0",
  "description": "Seego design tokens (colors, typography, radii, spacing). Pure TypeScript, no React/React Native dependency.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tailwind": "./src/tailwind.ts",
    "./css": "./src/theme.css",
    "./fonts.css": "./src/fonts.css",
    "./fonts/*": "./fonts/*"
  },
  "scripts": {
    "generate:css": "tsx scripts/generate-css.ts",
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && pnpm audit:contrast",
    "audit:contrast": "tsx scripts/audit-contrast.ts"
  },
  "devDependencies": {
    "@seego/eslint-config": "workspace:*",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
